# The Supabase project used for authentication. HokieHub's marketplace data does
# not live in Supabase — it lives in the Postgres behind the Spring API — so this
# project only needs its email provider enabled.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-key

# Where the Spring Boot API is reachable.
NEXT_PUBLIC_API_URL=http://localhost:8080

# This app's own origin. The account-confirmation email links back here, so
# pointing it at the API would send every new account to a service that has no
# such route.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
